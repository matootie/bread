{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "build/**",
        "api/**",
        "public/build/**",
        "lib/out/**"
      ]
    },
    "develop": {
      "cache": false
    },
    "package": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "out/**"
      ]
    },
    "deploy": {
      "dependsOn": [
        "package"
      ]
    }
  }
}
